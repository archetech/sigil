# Sigil — live e2e configuration (copy to .env; .env is gitignored). No hostnames or secrets are committed.
#
# Point these at whichever Archon node you run against — a public node, or your own on the LAN.
# The live resolver e2e (`npm run e2e:archon`) reads them; the unit tests need none of this.

# Gatekeeper / drawbridge base URL used for DID resolution (operation-log replay).
SIGIL_GATEKEEPER_URL=https://archon.technology
# Optional admin key, if your gatekeeper requires one.
#SIGIL_GATEKEEPER_API_KEY=

# Optional: a keymaster URL. If set, the e2e provisions an ephemeral agent DID, resolves it, then removes it.
# Leave unset to skip provisioning and only resolve DIDs you pass on the command line.
#SIGIL_KEYMASTER_URL=
#SIGIL_KEYMASTER_API_KEY=

# Optional registry for the ephemeral DID. On a local dev node, "local" resolves fastest.
#SIGIL_E2E_REGISTRY=local

# Optional: extra DIDs to resolve (comma-separated). You can also pass them as CLI args.
#SIGIL_E2E_DIDS=did:cid:...,did:cid:...
